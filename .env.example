# Copy to .env and fill in real values. .env is git-ignored.
# These are read only on the server; they are never sent to the browser.

# Host where OBS Studio is running. From Docker on macOS use host.docker.internal.
OBS_HOST=127.0.0.1
# OBS WebSocket server port (OBS default: 4455).
OBS_PORT=4455
# Password from OBS > Tools > WebSocket Server Settings.
OBS_PASSWORD=change-me
