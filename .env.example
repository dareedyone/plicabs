# Copy to .env and fill in real values. .env is git-ignored.
# These are read only on the server; they are never sent to the browser.
# The app refuses to start if OBS_HOST or OBS_PORT is missing or invalid.

# Required. Hostname or IP address of the machine running OBS Studio (no protocol or port).
# Local Node: 127.0.0.1. Docker on macOS / Docker Desktop: host.docker.internal.
# Docker on Linux: host.docker.internal and --add-host=host.docker.internal:host-gateway.
OBS_HOST=127.0.0.1
# Required. OBS WebSocket server port (OBS default: 4455).
OBS_PORT=4455
# Optional. Password from OBS > Tools > WebSocket Server Settings.
# Leave empty if authentication is disabled in OBS.
OBS_PASSWORD=change-me
